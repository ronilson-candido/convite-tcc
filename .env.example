# Use as variáveis do projeto Supabase (Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-anon

# Exclusiva do servidor. Nunca use o prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Lista de e-mails já cadastrados no Supabase Auth, separados por vírgula.
ADMIN_EMAILS=administrador@exemplo.com

# Segredo aleatório forte para gerar identificadores HMAC dos IPs.
# Gere com: openssl rand -hex 32
RATE_LIMIT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
